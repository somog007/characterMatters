// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String?
  name      String?
  posts     Post[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

// Prisma schema for Character Matters (PostgreSQL)

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  PARENT
  TEACHER
  SCHOOL_ADMIN
  ADMIN
}

enum AgeGroup {
  TODDLER    // Ages 2 & 3
  PRE_K      // Ages 4 & 5
  SCHOOL_AGE // Ages 6 - 10
}

enum AccessTier {
  BRONZE
  SILVER
  GOLD
  SAPPHIRE
  DIAMOND
  PLATINUM
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  CANCELED
  EXPIRED
}

enum BillingCycle {
  ACADEMIC_SESSION
  MONTHLY
  YEARLY
}

enum PaymentProvider {
  PAYSTACK
  MANUAL
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  passwordHash         String
  fullName             String
  role                 Role              @default(USER)
  status               String            @default("active")
  schoolName           String?
  phone                String?
  avatar               String?
  maxAllowedDevices    Int               @default(2)
  paystackCustomerCode String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  subscription         Subscription?
  childProfiles        ChildProfile[]
  paystackTransactions PaystackTransaction[]
  securityLogs         SecurityLog[]
  deviceSessions       DeviceSession[]
  playbackSessions     PlaybackSession[]

  @@map("users")
}

model Subscription {
  id                       String             @id @default(uuid())
  userId                   String             @unique
  user                     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                     String             // 'platinum' | 'diamond' | 'sapphire' | 'gold' | 'silver' | 'bronze'
  status                   SubscriptionStatus @default(PENDING)
  billingCycle             BillingCycle       @default(ACADEMIC_SESSION)
  priceAmountNgn           Decimal            @db.Decimal(12, 2)
  startDate                DateTime           @default(now())
  endDate                  DateTime?
  currentPeriodStart       DateTime?
  currentPeriodEnd         DateTime?
  canceledAt               DateTime?
  paystackCustomerCode     String?
  paystackSubscriptionCode String?
  providerReference        String?
  paymentProvider          PaymentProvider    @default(PAYSTACK)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@map("subscriptions")
}

model ChildProfile {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  ageGroup  AgeGroup
  avatarUrl String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  progress  LessonProgress[]

  @@map("child_profiles")
}

model Lesson {
  id             String       @id @default(uuid())
  title          String
  description    String?
  ageGroup       AgeGroup
  accessTier     AccessTier   @default(BRONZE)
  categoryId     String?
  category       Category?    @relation(fields: [categoryId], references: [id])
  videoUrl       String       // Cloudinary Video URL / HLS Stream
  hlsManifestPath String?     // HLS manifest path
  thumbnailUrl   String?      // Cloudinary Image URL
  worksheetUrl   String?      // Cloudinary PDF URL
  durationSeconds Int         @default(0)
  isPublished    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  progressRecords  LessonProgress[]
  playbackSessions PlaybackSession[]

  @@map("lessons")
}

model LessonProgress {
  id             String       @id @default(uuid())
  childProfileId String
  childProfile   ChildProfile @relation(fields: [childProfileId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed      Boolean      @default(false)
  lastPositionSec Int         @default(0)
  watchedSeconds Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([childProfileId, lessonId])
  @@map("lesson_progress")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]

  @@map("categories")
}

model Ebook {
  id          String   @id @default(uuid())
  title       String
  description String?
  author      String?
  coverUrl    String?   // Cloudinary Image URL
  fileUrl     String?   // Cloudinary PDF URL
  price       Decimal  @db.Decimal(12, 2) @default(0)
  accessTier  AccessTier @default(BRONZE)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("ebooks")
}

model GalleryItem {
  id          String    @id @default(uuid())
  title       String
  description String?
  category    String    // 'Events' | 'School Seminars'
  mediaType   MediaType
  mediaUrl    String    // Cloudinary URL
  thumbnailUrl String?
  location    String?
  school      String?
  eventDate   DateTime?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("gallery_items")
}

model PlaybackSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  ipAddress    String
  userAgent    String
  deviceId     String
  status       String   @default("active") // 'active' | 'expired' | 'revoked'
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("playback_sessions")
}

model DeviceSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  deviceName String?
  ipAddress  String?
  lastActive DateTime @default(now())
  isBlocked  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([userId, deviceId])
  @@map("device_sessions")
}

model WatermarkConfig {
  id                      String  @id @default(uuid())
  logoUrl                 String  @default("/assets/watermark-logo.png")
  websiteDomain           String  @default("CharacterMatters.com")
  opacity                 Float   @default(0.3)
  fontSize                Int     @default(14)
  movementIntervalSeconds Int     @default(30)

  @@map("watermark_config")
}

model PaystackTransaction {
  id             String        @id @default(uuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference      String        @unique
  amountNgn      Decimal       @db.Decimal(12, 2)
  status         String        // 'success' | 'failed' | 'abandoned'
  planId         String
  channel        String?
  paidAt         DateTime?
  rawWebhookData Json?
  createdAt      DateTime      @default(now())

  @@map("paystack_transactions")
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventType String
  severity  String   @default("info")
  ipAddress String
  userAgent String
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("security_logs")
}

