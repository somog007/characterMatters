# Runtime and public origins
NODE_ENV=production
SITE_URL=https://charactermattersng.org
NEXT_PUBLIC_SITE_URL=https://charactermattersng.org
API_URL=https://charactermattersng.org/api
NEXT_PUBLIC_API_URL=/api

# Prisma Postgres connection strings use the standard PostgreSQL protocol.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional pooled connection for serverless Functions:
# DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Generate a unique value of at least 32 characters; use the same value in all functions.
JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# SendGrid API key with Mail Send permission and a verified sender identity.
SENDGRID_API_KEY=SG.replace-with-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@charactermattersng.org

# Optional integrations
SENTRY_DSN=
REDIS_URL=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=https://charactermattersng.org/subscribe
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CDN_SIGNING_SECRET=
HLS_AES_128_MASTER_KEY=
SENDGRID_DATA_RESIDENCY=
PORT=5000
INITIAL_ADMIN_PASSWORD=
INITIAL_WEAVERS_PASSWORD=

# Optional auth smoke-test inputs; never use a real user's password.
SMOKE_TEST_SITE_URL=https://www.charactermattersng.org
SMOKE_TEST_EMAIL=
SMOKE_TEST_PASSWORD=

# Optional deployment-hook helper inputs.
NETLIFY_BUILD_HOOK_URL=
NETLIFY_BUILD_BRANCH=main
NETLIFY_BUILD_MESSAGE=
