{
  "name": "character-matters-workspace",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Character Matters Video & eBook Platform Monorepo Workspace",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "dev:welcome": "npm --prefix welcome run dev",
    "dev:all": "npx concurrently \"npm --prefix backend run dev\" \"npm --prefix web run dev\" \"npm --prefix welcome run dev\"",
    "dev:web": "npm --prefix web run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix backend run build && npm --prefix web run build && npm --prefix welcome run build",
    "install:all": "npm --prefix backend install && npm --prefix web install && npm --prefix welcome install",
    "prisma:generate": "npm --prefix backend run prisma:generate",
    "prisma:deploy": "npm --prefix backend run prisma:deploy",
    "prisma8:generate": "prisma contract emit",
    "prisma:check-versions": "node scripts/check-prisma-versions.cjs"
  },
  "workspaces": [
    "backend",
    "web",
    "welcome"
  ],
  "dependencies": {
    "@netlify/plugin-nextjs": "5.16.1",
    "@prisma/client": "7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "@sendgrid/client": "8.1.6",
    "@sendgrid/mail": "^8.1.6",
    "eslint-config-next": "16.3.8",
    "next": "16.3.8",
    "qs": "6.16.0",
    "temporal-polyfill": "1.0.5"
  },
  "devDependencies": {
    "@prisma/prisma7": "7.10.0",
    "@types/node": "^20.5.0",
    "prisma": "8.0.0-rc.18"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
