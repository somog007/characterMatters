# Character Matters Backend — Environment Variables
# Copy this file to .env and fill in values

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/charactermatters?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/charactermatters?schema=public"

# Auth
JWT_SECRET="your-jwt-secret-here"

# Frontend URL (for CORS and callbacks)
FRONTEND_URL="http://localhost:3000"

# Paystack (payment processing)
PAYSTACK_SECRET_KEY="sk_test_8308925a2d21614d967080d1b2d9fe4fe7572864"
PAYSTACK_PUBLIC_KEY="pk_test_d1ce41fffe04f8d9cb74aaf8d546b90b1918bb0e"
PAYSTACK_CALLBACK_URL="http://localhost:3000/subscribe"

# Cloudinary (media hosting)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# SendGrid (transactional email)
SENDGRID_API_KEY="SG.xxx"
FROM_EMAIL="noreply@charactermatters.com"

# Video Security
CDN_SIGNING_SECRET="your-cdn-signing-secret"
HLS_AES_128_MASTER_KEY="0123456789abcdef0123456789abcdef"

# Optional
SENTRY_DSN=""
REDIS_URL=""
PORT=5000
