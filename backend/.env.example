# Character Matters Backend — Environment Variables
# Copy this file to .env and fill in values

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/charactermatters?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/charactermatters?schema=public"

# Auth
JWT_SECRET="replace-with-at-least-32-random-characters"
INITIAL_ADMIN_PASSWORD=""
INITIAL_WEAVERS_PASSWORD=""

# Frontend URL (for CORS and callbacks)
FRONTEND_URL="http://localhost:3000"

# Paystack (payment processing)
PAYSTACK_SECRET_KEY="replace-with-test-or-live-secret-from-paystack-dashboard"
PAYSTACK_PUBLIC_KEY="replace-with-test-or-live-public-key-from-paystack-dashboard"
PAYSTACK_CALLBACK_URL="http://localhost:3000/subscribe"

# Cloudinary (media hosting)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# SendGrid (transactional email)
SENDGRID_API_KEY="SG.xxx"
FROM_EMAIL="noreply@charactermatters.com"
# Set to "eu" only when using an EU regional subuser; otherwise leave unset.
SENDGRID_DATA_RESIDENCY=""

# Video Security
CDN_SIGNING_SECRET=""
# 16-byte AES-128 key encoded as 32 hexadecimal characters; must match the HLS encryption key.
HLS_AES_128_MASTER_KEY=""

# Optional
SENTRY_DSN=""
REDIS_URL=""
PORT=5000
