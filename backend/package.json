{
  "name": "video-ebook-platform-backend",
  "version": "1.0.0",
  "description": "Backend for Character Matters video streaming and eBook platform",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "nodemon",
    "build": "prisma7 generate --config ../prisma7.config.ts && tsc",
    "test": "jest",
    "prisma:generate": "prisma7 generate --config ../prisma7.config.ts",
    "prisma:migrate": "prisma7 migrate dev --config ../prisma7.config.ts",
    "prisma:deploy": "prisma7 migrate deploy --config ../prisma7.config.ts"
  },
  "dependencies": {
    "@sendgrid/client": "8.1.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prisma/orm-postgres": "8.0.0-rc.12",
    "@sendgrid/mail": "8.1.6",
    "@sentry/node": "^10.47.0",
    "@sentry/profiling-node": "^10.47.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.0.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "2.4.0",
    "pg": "^8.16.3",
    "serverless-http": "^3.2.0",
    "temporal-polyfill": "1.0.5",
    "winston": "^3.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^1.4.7",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.3.0",
    "nodemon": "^3.0.1",
    "@prisma/prisma7": "7.10.0",
    "prisma": "8.0.0-rc.18",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
