# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL via Prisma ORM)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/character_matters_db?schema=public

# MongoDB (Legacy / Migration)
MONGODB_URI=mongodb://localhost:27017/video-ebook-platform

# Redis In-Memory Cache & Session Store
REDIS_URL=redis://127.0.0.1:6379

# Cloudinary Storage & Media Delivery
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Paystack Payment Gateway (Nigeria NGN Academic Session Packs)
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_CALLBACK_URL=http://localhost:3000/subscribe?status=success

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# Frontend URL
FRONTEND_URL=http://localhost:3000

# AWS S3 (Optional / Legacy Backup)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name

# Stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# SendGrid Email
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@charactermatters.ng
